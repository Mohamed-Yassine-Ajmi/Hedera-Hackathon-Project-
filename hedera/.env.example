# ==============================================================================
# HEDERA HASHGRAPH ENVIRONMENT CONFIGURATION
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit the actual .env file or any private keys to version control.
# - Ensure .env is listed in .gitignore.
# - Never expose private keys in frontend bundles or client-side code.
# ==============================================================================

# Target Hedera Network: testnet | mainnet | previewnet | local-node
HEDERA_NETWORK=testnet

# Operator Account ID (format: 0.0.xxxxxx)
# Obtained from Hedera Portal (https://portal.hedera.com)
OPERATOR_ID=0.0.xxxxxx

# Operator Private Key (DER hex or raw hex format)
OPERATOR_KEY=302e020100300506032b657004220420...

# Operator Key Type: ED25519 or ECDSA
OPERATOR_KEY_TYPE=ED25519

# ==============================================================================
# HEDERA CONSENSUS SERVICE (HCS) TOPIC IDS
# To be filled in later after creating topics via scripts or Hedera console.
# ==============================================================================
TOPIC_ID_1=0.0.xxxxxx
TOPIC_ID_2=0.0.xxxxxx
TOPIC_ID_3=0.0.xxxxxx

# Optional Descriptive Aliases for the Three Topics (if applicable):
# TOPIC_AUDIT_ID=0.0.xxxxxx
# TOPIC_EVENTS_ID=0.0.xxxxxx
# TOPIC_CREDENTIALS_ID=0.0.xxxxxx

# Mirror Node REST API Base URL (defaults to Hedera public testnet mirror if omitted)
# HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
